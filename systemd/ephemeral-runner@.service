[Unit]
StartLimitIntervalSec=0
Description=Ephemeral GitHub Actions runner (%i)
Wants=network-online.target docker.service
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
ExecStartPre=-/usr/local/libexec/ephemeral-runner/runner-cleanup.py --instance %i --sweep
ExecStart=/usr/local/libexec/ephemeral-runner/runner-once.sh %i
# Forced stop path: planned maintenance must wait for natural exit instead.
ExecStop=/usr/local/libexec/ephemeral-runner/runner-cleanup.py --instance %i --service-stop
ExecStopPost=-/usr/local/libexec/ephemeral-runner/runner-cleanup.py --instance %i --current
Restart=always
# Fixed bounded retry frequency, with eventual recovery after long outages.
RestartSec=60
RestartPreventExitStatus=75
TimeoutStopSec=120
# docker run returns 143 (128 + SIGTERM) on a deliberate docker stop.
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
